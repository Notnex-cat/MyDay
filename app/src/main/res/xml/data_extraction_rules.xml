<?xml version="1.0" encoding="utf-8"?>
<!-- Резервная копия Android (12 и новее). Набор ключей SecretStore зашифрован ключом из Keystore,
     который в копию не попадает: на другом телефоне этот файл всё равно не прочитать. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secret_keyset_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secret_keyset_prefs.xml" />
    </device-transfer>
</data-extraction-rules>
